# Copy to .env.local and fill in. Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: set when deployed so the PayPal webhook registers itself
PUBLIC_URL=
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_AGENT_MODEL=gemini-3.5-flash
HOLD_SECONDS=120
# Sandbox test buyer shown in judge mode
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
